<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NoxVault">
 <SolidColorBrush x:Key="SurfaceBackground" Color="#0D0F12"/>
 <SolidColorBrush x:Key="SidebarBackground" Color="#0A0C0F"/>
 <SolidColorBrush x:Key="PanelBackground" Color="#111419"/>
 <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>
 <SolidColorBrush x:Key="MutedText" Color="#8D96A3"/>
 <Style x:Key="KeyboardFocusRing" TargetType="Control">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Border BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SecondaryButton" TargetType="Button">
  <Setter Property="Background" Value="#171B21"/><Setter Property="Foreground" Value="#F1F3F5"/>
  <Setter Property="BorderBrush" Value="#252A31"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,0"/>
  <Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid>
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
    <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="6" IsHitTestVisible="False"/>
    <Border x:Name="Pressed" Background="Black" Opacity="0" CornerRadius="6" IsHitTestVisible="False"/>
    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.06" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pressed" Property="Opacity" Value="0.16"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Background" Value="#3B82F6"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinHeight" Value="38"/></Style>
 <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
 <Style x:Key="CredentialIconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Foreground" Value="#8D96A3"/><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0"/></Style>
 <Style x:Key="SettingsAction" TargetType="Button" BasedOn="{StaticResource GhostButton}"/>
 <Style x:Key="SettingsDisclosure" TargetType="Expander">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
   <StackPanel>
    <ToggleButton Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand" FocusVisualStyle="{StaticResource KeyboardFocusRing}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Hover" Background="Transparent" CornerRadius="5" Padding="8,12">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ContentPresenter VerticalAlignment="Center"/>
        <Path x:Name="Chevron" Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" Width="8" Height="4" VerticalAlignment="Center" Margin="12,0,4,0" RenderTransformOrigin="0.5,0.5"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Background" Value="#171B21"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers>
     </ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="8,0,8,12"/>
   </StackPanel>
   <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="AccountEditorDisclosure" TargetType="Expander">
  <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
   <StackPanel>
    <ToggleButton x:Name="Toggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Foreground="{TemplateBinding Foreground}" Cursor="Hand" FocusVisualStyle="{StaticResource KeyboardFocusRing}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Hover" Background="Transparent" CornerRadius="5" Padding="8,12">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Weitere Angaben" FontSize="13" Foreground="{TemplateBinding Foreground}"/><TextBlock Text="Login-Seite, Notizen &amp; eigene Felder" FontSize="11" Foreground="#747C89" Margin="0,4,0,0"/></StackPanel>
        <Path x:Name="Chevron" Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" Width="8" Height="4" VerticalAlignment="Center" Margin="12,0,4,0" RenderTransformOrigin="0.5,0.5"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Background" Value="#171B21"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers>
     </ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="8,0,8,12"/>
   </StackPanel>
   <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SidebarItem" TargetType="Button" BasedOn="{StaticResource GhostButton}">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,8"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid>
    <Border x:Name="Surface" Background="Transparent" CornerRadius="5"/>
    <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="5"/>

    <Border x:Name="Focus" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5"/>
    <Border x:Name="DropTarget" Background="#172332" BorderBrush="#526276" BorderThickness="1" CornerRadius="5" Opacity="0" IsHitTestVisible="False"/>
    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="local:DesktopVisuals.IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1F3B82F6"/></Trigger>
    <Trigger Property="local:DesktopVisuals.IsDropTarget" Value="True"><Setter TargetName="DropTarget" Property="Opacity" Value="1"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.04" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#252A31"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="AccountListItem" TargetType="Button" BasedOn="{StaticResource SidebarItem}"/>
 <Style TargetType="TextBox">
  <Setter Property="Background" Value="#0D0F12"/><Setter Property="Foreground" Value="#F1F3F5"/><Setter Property="CaretBrush" Value="#F1F3F5"/><Setter Property="SelectionBrush" Value="#3B82F6"/><Setter Property="BorderBrush" Value="#252A31"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="14"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="B" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><Decorator x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#171B21"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="Background" Value="#1B222C"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="PasswordBox">
  <Setter Property="Background" Value="#0D0F12"/><Setter Property="Foreground" Value="#F1F3F5"/><Setter Property="CaretBrush" Value="#F1F3F5"/><Setter Property="BorderBrush" Value="#252A31"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="14"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="B" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><Decorator x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#171B21"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="Background" Value="#1B222C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBox">
  <Setter Property="Foreground" Value="#F1F3F5"/><Setter Property="MinHeight" Value="38"/><Setter Property="FontSize" Value="13"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="B" Background="#0D0F12" BorderThickness="0" CornerRadius="6"><TextBlock Text="⌄" Margin="12,8" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8D96A3"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#171B21"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="#1B222C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
   <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="12,8,30,8" VerticalAlignment="Center" IsHitTestVisible="False"/>
   <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#111419" BorderBrush="#292E35" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280"><ScrollViewer Margin="4"><ItemsPresenter/></ScrollViewer></Border></Popup>
  </Grid></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F1F3F5"/><Setter Property="Padding" Value="12,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="B" Padding="{TemplateBinding Padding}" CornerRadius="5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="B" Property="Background" Value="#171B21"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ContextMenu"><Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="Foreground" Value="#D7DBE0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="#111419" BorderBrush="#252A31" BorderThickness="1" CornerRadius="6" Padding="5"><ItemsPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#D7DBE0"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,8"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Item" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#1C2026"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsHighlighted" Value="True"/><Condition Property="local:DesktopVisuals.IsDestructive" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Item" Property="Background" Value="#332D171C"/></MultiTrigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Separator"><Setter Property="Margin" Value="10,5"/><Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="#252A31"/></ControlTemplate></Setter.Value></Setter></Style>
<!-- WPF assigns this keyed style to separators inside menus, overriding the implicit style. -->
 <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}"/>
</ResourceDictionary>
