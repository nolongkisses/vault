<Application x:Class="NoxVault.App" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Index 0 is the palette; Theme.Apply swaps it for Light.xaml or back. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Interface/Theme/Dark.xaml"/>
        <ResourceDictionary Source="Interface/Theme/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
